#!/bin/sh
# ATDD pre-merge-commit hook — version gate + main-merge protection.
# Installed by `atdd init`. Bypasses require CI=true.

set -e

# --- Bypass audit helper (E026) ---
_emit_bypass_audit() {
    _flag="$1"
    _hook="$2"
    _reason="${ATDD_BYPASS_REASON:-}"
    if [ -z "$_reason" ]; then
        printf "ATDD WARNING: %s=1 used without ATDD_BYPASS_REASON.\n" "$_flag" >&2
        printf "  Set ATDD_BYPASS_REASON=<reason> alongside the flag to document this bypass.\n" >&2
    else
        _repo_root="${ATDD_REPO_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || echo "")}"
        if [ -n "$_repo_root" ] && [ -d "${_repo_root}/.atdd" ]; then
            _ts=$(date -u +"%Y-%m-%dT%H:%M:%SZ" 2>/dev/null || echo "unknown")
            printf '{"timestamp":"%s","flag":"%s","reason":"%s","hook":"%s"}\n' \
                "$_ts" "$_flag" "${_reason}" "$_hook" \
                >> "${_repo_root}/.atdd/bypass-audit.jsonl" 2>/dev/null || true
        fi
    fi
}

# --- Version gate (CI can skip with ATDD_SKIP_VERSION_GATE=1) ---
if [ "${CI:-}" = "true" ] && [ "${ATDD_SKIP_VERSION_GATE:-0}" = "1" ]; then
    : # CI bypass
else
    python3 -c "
try:
    from atdd.version_check import _gate_main
    _gate_main()
except ImportError:
    import sys
    print('ATDD: version gate requires a newer atdd package.', file=sys.stderr)
    try:
        from atdd.version_check import upgrade_command
        print('  Run: ' + upgrade_command(), file=sys.stderr)
    except Exception:
        print('  Run: pipx upgrade atdd', file=sys.stderr)
    sys.exit(1)
" 2>&1
    if [ $? -ne 0 ]; then exit 1; fi
fi

# --- Block merges into main/master ---
BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null || echo "")

case "$BRANCH" in
    main|master) ;;
    *) exit 0 ;;
esac

# Allow: CI-only env bypass
if [ "${CI:-}" = "true" ] && [ "${ATDD_ALLOW_MAIN_MERGE:-0}" = "1" ]; then
    exit 0
fi

cat >&2 <<EOF

ATDD: Direct merges into $BRANCH are blocked.

Use a PR workflow instead of merging locally.
Work in a worktree branch:
  atdd branch <issue-number>

CI bypass (requires CI=true):
  CI=true ATDD_ALLOW_MAIN_MERGE=1 git merge ...

EOF
exit 1
