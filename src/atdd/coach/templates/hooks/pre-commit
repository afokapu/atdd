#!/bin/sh
# ATDD pre-commit hook — blocks commits on main/master and unregistered branches.
# Installed by `atdd init`.
#
# All ATDD_SKIP_* bypass env vars have been retired (E030, 2026-05-26).
# For genuine emergencies: atdd emergency --reason "<reason>"

set -e

# --- Emergency bypass check (E031) ---
_REPO_ROOT="${ATDD_REPO_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || echo "")}"

# --- Source-checkout live-source bridge (#928 Gap 4 Item 3) ---
# Inside the atdd toolkit source checkout, prepend src/ so the bare `python3`
# version gate AND `atdd validate` import atdd from the WORKING TREE, not the
# installed wheel. Removes the manual `PYTHONPATH=src` bridge; no-op elsewhere.
if [ -n "$_REPO_ROOT" ] && [ -d "$_REPO_ROOT/src/atdd" ] && \
   grep -q '^name = "atdd"' "$_REPO_ROOT/pyproject.toml" 2>/dev/null; then
    export PYTHONPATH="$_REPO_ROOT/src${PYTHONPATH:+:$PYTHONPATH}"
fi
if [ -n "$_REPO_ROOT" ]; then
    _BYPASS_FILE="${_REPO_ROOT}/.atdd/EMERGENCY_BYPASS"
    if [ -f "$_BYPASS_FILE" ]; then
        if find "$_BYPASS_FILE" -mmin -5 2>/dev/null | grep -q .; then
            printf "ATDD: Emergency bypass active (pre-commit). Reason: %s\n" \
                "$(head -1 "$_BYPASS_FILE" 2>/dev/null | sed 's/^reason=//' || echo 'see .atdd/EMERGENCY_BYPASS')" >&2
            exit 0
        else
            printf "ATDD: Emergency bypass file found but expired (> 5 min). Ignored.\n" >&2
        fi
    fi
fi

# --- Resolve current branch ---
BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null || echo "")

# Allow: detached HEAD (CI)
if [ -z "$BRANCH" ]; then
    exit 0
fi

# --- Block all direct commits on main/master ---
case "$BRANCH" in
    main|master)
        # Allow: CI-only env bypass
        if [ "${CI:-}" = "true" ] && [ "${ATDD_ALLOW_MAIN_COMMIT:-0}" = "1" ]; then
            exit 0
        fi
        # Allow: manifest-only registration commit (atdd author issue runs on main)
        # A commit whose staged set is exactly .atdd/manifest.yaml cannot cause the
        # harm this guard exists to prevent (mass code edits, bare-mode contamination).
        _STAGED=$(git diff --cached --name-only 2>/dev/null || echo "")
        if [ "$_STAGED" = ".atdd/manifest.yaml" ]; then
            exit 0
        fi
        cat >&2 <<EOF

ATDD: Commit blocked — you are on $BRANCH.

NEVER edit files directly on $BRANCH.
Always create a worktree branch FIRST, before making any changes:

  atdd worktree create <issue-number>

If you already have uncommitted changes, recover them:

  git stash
  atdd worktree create <issue-number>
  cd ../<worktree-dir>
  git stash pop

CI bypass (requires CI=true):
  CI=true ATDD_ALLOW_MAIN_COMMIT=1 git commit ...

EOF
        exit 1
        ;;
esac

# --- Verify branch is registered (store-backed, #1270 slice C) ---
# Resolves branch → work item through the State Store (manifest fallback) via
# `atdd coach is-registered`, replacing the legacy `grep "slug:" manifest.yaml`.
# (Repointed from `atdd issue is-registered` by #1382/C5a so C5b's deletion of the
# `atdd issue` monolith cannot break the commit gate.)
# Skips when atdd is unavailable (never hard-breaks a commit) and when the repo
# is not atdd-managed (the helper exits 0 with nothing to check).
if command -v atdd >/dev/null 2>&1; then
    if ! atdd coach is-registered "$BRANCH" >/dev/null 2>&1; then
        cat >&2 <<EOF

ATDD: Branch '$BRANCH' is not registered as an ATDD work item.

Self-heal:
  atdd coach reconcile

Every branch must be created through the ATDD workflow:
  1. atdd author issue --title <t> --slug <s>   # Create issue first
  2. atdd worktree create <N>     # Create the worktree from the issue

For genuine emergencies: atdd emergency --reason "<reason>"

EOF
        exit 1
    fi
fi

# --- Staged file count warning (advisory only — never blocks) ---
STAGED=$(git diff --cached --name-only | wc -l | tr -d ' ')
MAX_STAGED=${ATDD_MAX_STAGED:-20}

if [ "$STAGED" -gt "$MAX_STAGED" ]; then
    echo "ATDD WARNING: $STAGED files staged. Consider splitting into smaller commits." >&2
fi

# --- Registry mirror auto-heal (wmbt:govern-lifecycle:E072, corrects E023) ---
# plan/_wagons.yaml, plan/_trains.yaml and contracts/_artifacts.yaml are generated
# mirrors of the wagon manifests. When a commit changes their sources the resync
# must ride along IN that commit.
#
# This runs at pre-commit and not at pre-push because only here does staging still
# reach the commit being created. E023 put the heal in pre-push, where git has
# already resolved the refs it will send, so the resync was staged and then left
# behind (#1888).
#
# Advisory on failure: a resync that fails says so and lets the commit through, so
# no work is ever stranded at commit time. pre-push refuses instead — a refusal
# there costs nothing, because the commits already exist.
# Auto-skipped: CI=true (CI does not author commits).
if [ "${CI:-}" != "true" ]; then
    if ! atdd registry update --check >/dev/null 2>&1; then
        if atdd registry update --yes >&2 2>&1; then
            git add plan/_wagons.yaml plan/_trains.yaml contracts/_artifacts.yaml 2>/dev/null || true
            echo "ATDD: registry mirrors resynced and included in this commit (atdd registry update --yes)" >&2
        else
            echo "ATDD: registry mirrors are drifted and 'atdd registry update --yes' FAILED." >&2
            echo "      They were NOT resynced. This commit proceeds; the push will refuse until they are." >&2
        fi
    fi
fi

exit 0
