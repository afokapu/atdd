#!/bin/sh
# ATDD L3a PATH shim for `gh` (issue #816).
#
# Installed by `atdd init` to .atdd/bin/gh and put first on PATH via direnv
# (`.envrc` → `PATH_add .atdd/bin`). It intercepts `gh issue create` in any
# worktree shell — dev-time or scripted — and forwards every other gh
# subcommand unchanged to the next real gh on PATH.
#
# Classification is exact: only `$1 == issue` AND `$2 == create` is blocked.
# Near-misses (`gh issuecreate`, `gh issue createfoo`) forward untouched.

if [ "$1" = "issue" ] && [ "$2" = "create" ]; then
    cat >&2 <<'EOF'
ATDD: `gh issue create` is blocked.

GitHub issues are the ATDD source of truth and must be created through the
toolkit so they are registered in the manifest and the State Store.

  Use:  atdd author issue --title <title> --slug <slug>

(See src/atdd/coach/conventions/path_shim_gh.convention.yaml)
EOF
    exit 1
fi

# --- Forward to the NEXT gh on PATH, never this shim (no infinite loop) ---
# Resolve our own directory, then rebuild PATH with that directory removed so
# the exec'd `gh` resolves to the real binary downstream of us.
self_dir=$(CDPATH= cd -- "$(dirname -- "$0")" 2>/dev/null && pwd -P)

new_path=""
saved_ifs=$IFS
IFS=:
for d in $PATH; do
    [ -z "$d" ] && continue
    rd=$(CDPATH= cd -- "$d" 2>/dev/null && pwd -P) || rd="$d"
    [ "$rd" = "$self_dir" ] && continue
    if [ -z "$new_path" ]; then
        new_path="$d"
    else
        new_path="$new_path:$d"
    fi
done
IFS=$saved_ifs

exec env PATH="$new_path" gh "$@"
