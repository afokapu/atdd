__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
*.egg-info/
dist/
build/
*.egg

# Virtual environments
.venv/
venv/
ENV/

# pytest
.pytest_cache/
htmlcov/
.coverage
coverage.xml

# IDE
.idea/
.vscode/
*.swp
*.swo

# ATDD cache + agent-local state
.atdd/cache/
.atdd/diagnostics/
.atdd/orchestration-log.jsonl
.atdd/worker-state-*.json
# Emergency bypass (E031): single-use file created by `atdd emergency --reason`
.atdd/EMERGENCY_BYPASS
.atdd/emergency-audit.jsonl
# Legacy bypass audit log (E026, superseded by E030)
.atdd/bypass-audit.jsonl
# Per-run runtime state — ephemeral, never committed (#755).
# Fully ignored so git add -A / git commit -a cannot accidentally pick up
# coach session files, decisions.jsonl, or any other per-run artifact.
.atdd/runtime/
# ATDD State Store (#1168). The local SQLite DB is private to a checkout and is never
# git-tracked; the PROJECTION is the shared source of truth and MUST be (#1580).
#
# This was a bare `.atdd/state/`, which ignored the projection too. A gitignored
# projection is empty at every HEAD, and reconcile read that emptiness as "delete
# everything" — the 2026-07-20 mass-deletion. Keep the two lines apart, and keep the
# negation: git will not descend into an excluded directory, so `.atdd/state/` must
# never again be ignored wholesale.
.atdd/state/state.sqlite*
.atdd/state/backups/
# Manifest import backup written on first authoritative store read (#1183/#1203); local-only.
.atdd/manifest.migrated.yaml
.scratch/

# Presentation ratchet smoke evidence — local/CI artifact, not git history.
# See COACH-RATCHET-PRES-001 (refactor.convention.yaml) and issue #358.
.atdd/smoke-evidence/

# OS
.DS_Store
Thumbs.db

.launch_prompt.txt
