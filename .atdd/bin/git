#!/bin/sh
# ATDD agent-agnostic PATH shim for `git` (issue #884).
#
# Installed by `atdd init` to .atdd/bin/git and put first on PATH via direnv
# (`.envrc` -> `PATH_add .atdd/bin`). It intercepts every shell's `git` call —
# Claude, GLM, Codex, Gemini, or a human — regardless of launch path, closing
# the asymmetry the Claude-Code-only PreToolUse hook (#668) leaves open.
#
# It BLOCKS unscoped writes that poison the SHARED .git/config (exit 1, the
# real git is never reached):
#     git config core.bare <value>          (no --worktree)
#     git config core.worktree <value>      (no --worktree)
#     git config core.hooksPath <value>     (no --worktree, only in a LINKED
#                                            worktree — atdd init legitimately
#                                            sets it unscoped in the main repo)
# It FORWARDS everything else unchanged to the next real git on PATH:
#     git config --worktree core.bare <value>   (scoped -> safe)
#     git config --get core.bare / git config core.bare   (reads)
#     git config --unset core.bare              (repair)
#     git -c core.bare=false <cmd>              (ephemeral override)
#     every other git subcommand
#
# Forwarding correctness is the main risk (git is hotter-path than gh): the
# forward uses `exec`, so argv, exit code, and stdin/stdout/stderr are all
# inherited and preserved byte-for-byte. Mirrors the gh shim from #816 and
# reuses the danger keys of the ATDD-FORBID-GIT-CONFIG-BARE-UNSCOPED rule.
# See src/atdd/coach/conventions/path_shim_git.convention.yaml.

# --- Resolve our own dir, then rebuild PATH with it removed so the exec'd ---
# --- `git` resolves to the real binary downstream of us (no infinite loop) ---
self_dir=$(CDPATH= cd -- "$(dirname -- "$0")" 2>/dev/null && pwd -P)

new_path=""
saved_ifs=$IFS
IFS=:
for d in $PATH; do
    [ -z "$d" ] && continue
    rd=$(CDPATH= cd -- "$d" 2>/dev/null && pwd -P) || rd="$d"
    [ "$rd" = "$self_dir" ] && continue
    if [ -z "$new_path" ]; then
        new_path="$d"
    else
        new_path="$new_path:$d"
    fi
done
IFS=$saved_ifs

# --- Find the git subcommand, skipping global options (and their arguments) ---
# Only the `config` subcommand is of interest; anything else forwards at once.
subcmd=""
skip_next=0
for tok in "$@"; do
    if [ "$skip_next" = "1" ]; then skip_next=0; continue; fi
    case "$tok" in
        # global options that consume the FOLLOWING argument
        -C|-c|--git-dir|--work-tree|--namespace|--exec-path|--super-prefix)
            skip_next=1; continue ;;
        # inline `--opt=value` forms and any other leading-dash global flag
        -*) continue ;;
        *) subcmd="$tok"; break ;;
    esac
done

if [ "$subcmd" != "config" ]; then
    exec env PATH="$new_path" git "$@"
fi

# --- `git config`: detect an unscoped WRITE to a danger key ---------------- #
# A "write" is a danger key immediately followed by a value (a non-flag token).
# Reads (`--get core.bare`, bare `core.bare`) and removals (`--unset core.bare`)
# have no trailing value and are forwarded. `--worktree` anywhere makes the
# write scoped and therefore safe.
_lc() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }

has_worktree=0
danger_key=""
prev=""
for tok in "$@"; do
    [ "$tok" = "--worktree" ] && has_worktree=1
    case "$(_lc "$prev")" in
        core.bare|core.worktree|core.hookspath)
            case "$tok" in
                -*) : ;;                 # next is a flag -> prev was a read
                *) danger_key="$prev" ;; # value follows -> prev is a write
            esac ;;
    esac
    prev="$tok"
done

# Not a danger-key write, or scoped with --worktree -> forward unchanged.
if [ "$has_worktree" = "1" ] || [ -z "$danger_key" ]; then
    exec env PATH="$new_path" git "$@"
fi

# core.hooksPath is set unscoped by `atdd init` in the MAIN repo by design
# (#793); only block it inside a linked worktree where it bleeds to siblings.
if [ "$(_lc "$danger_key")" = "core.hookspath" ]; then
    gd=$(env PATH="$new_path" git rev-parse --git-dir 2>/dev/null)
    gcd=$(env PATH="$new_path" git rev-parse --git-common-dir 2>/dev/null)
    if [ -z "$gd" ] || [ "$gd" = "$gcd" ]; then
        exec env PATH="$new_path" git "$@"   # main / not linked -> allow
    fi
fi

cat >&2 <<EOF
ATDD: \`git config $danger_key <value>\` without \`--worktree\` is blocked.

An unscoped write to $danger_key lands in the SHARED .git/config and poisons
every linked worktree (including main), which then report
"fatal: this operation must be run in a work tree" until manually repaired
(the recurring 2026-05-12 worktree-config-bleed incident).

  Use:  git config --worktree $danger_key <value>

so the flag stays scoped to this worktree's config.
(See src/atdd/coach/conventions/path_shim_git.convention.yaml)
EOF
exit 1
